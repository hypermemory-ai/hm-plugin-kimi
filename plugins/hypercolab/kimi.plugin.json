{
  "name": "hypercolab",
  "version": "2.8.0",
  "description": "Coordinate developers and coding agents with project-scoped memory, timelines, work claims, and collision protection.",
  "author": "HyperMemory AI <info@hypermemory.io>",
  "homepage": "https://hypermemory.io",
  "license": "MIT",
  "keywords": [
    "hypermemory",
    "collaboration",
    "coding-agents",
    "mcp",
    "git"
  ],
  "skills": "./skills/",
  "agents": "./agents/",
  "mcpServers": {
    "hypercolab": {
      "command": "hypercolab",
      "args": ["mcp"]
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "python3 ./scripts/hypercolab_hook.py",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash|Edit|Write",
      "command": "python3 ./scripts/hypercolab_hook.py",
      "timeout": 30
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash|Edit|Write",
      "command": "python3 ./scripts/hypercolab_hook.py",
      "timeout": 10
    },
    {
      "event": "Stop",
      "command": "python3 ./scripts/hypercolab_hook.py",
      "timeout": 10
    }
  ],
  "interface": {
    "displayName": "HyperColab",
    "shortDescription": "Keep coding agents coordinated across a project",
    "longDescription": "Give every developer and coding agent the same project graph, chronological development timeline, active work ownership, and deterministic file-level collision protection.",
    "developerName": "HyperMemory AI",
    "websiteURL": "https://hypermemory.io",
    "brandColor": "#2875E5",
    "composerIcon": "./assets/icon.png",
    "logo": "./assets/logo.png"
  }
}
